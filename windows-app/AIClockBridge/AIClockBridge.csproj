<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows port of mac-app/: same tray-icon bridge (status server, screen
       mirror, quota, stock data, Bilibili profiles, petdex picker). WinForms;
       ImageSharp is the one third-party dep, needed because
       System.Drawing cannot decode petdex's WebP spritesheets nor author
       multi-frame GIFs. EnableWindowsTargeting lets the project compile on
       non-Windows hosts too (CI / cross-checks); it only runs on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AIClockBridge</AssemblyName>
    <RootNamespace>AIClockBridge</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Release version. Single source of truth: build-release.ps1 reads
       <Version> from this file to name dist\AIClockBridge-<Version>-Windows-x64.

       The Windows bridge versions INDEPENDENTLY of the firmware (which tracks
       FW_VERSION in firmware/include/config.h). The two used to move in step;
       they no longer do, because bridge-only work - autostart, single instance,
       quota-cache fixes - ships without touching the device at all and leaves
       the device protocol unchanged. 0.5.0 is where the two lines split.

       To release: bump this, add a CHANGELOG.md entry, run build-release.ps1.
       The payload folder name follows automatically. -->
  <PropertyGroup>
    <Version>0.5.17</Version>
    <Product>AIClockBridge</Product>
    <Company>esp8266-ai</Company>
    <Description>AI Clock Bridge - tray bridge for the SD2 ESP8266 status display</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\claude-logo.png" />
    <EmbeddedResource Include="Assets\codex-logo.png" />
    <EmbeddedResource Include="Assets\happy-mac.png" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebViewWpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
